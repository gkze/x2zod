{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "gen": {
      "inputs": ["package.json", "src/**/*.ts", "$TURBO_ROOT$/.oxfmtrc.json", "tsconfig.json"],
      "outputs": ["schema/build-inputs.schema.json"]
    },
    "gen:check": {
      "inputs": [
        "package.json",
        "schema/build-inputs.schema.json",
        "src/**/*.ts",
        "$TURBO_ROOT$/.oxfmtrc.json",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "gen:schema": {
      "inputs": ["package.json", "src/**/*.ts", "$TURBO_ROOT$/.oxfmtrc.json", "tsconfig.json"],
      "outputs": ["schema/build-inputs.schema.json"]
    },
    "gen:check:schema": {
      "inputs": [
        "package.json",
        "schema/build-inputs.schema.json",
        "src/**/*.ts",
        "$TURBO_ROOT$/.oxfmtrc.json",
        "tsconfig.json"
      ],
      "outputs": []
    }
  }
}
